== /.zshenv ==
# >>> shm >>>
# Managed by shm; changes inside this block are overwritten. Config: ~/.zsh/
skip_global_compinit=1
[[ -r "$HOME/.zsh/env.zsh" ]] && source "$HOME/.zsh/env.zsh"
# <<< shm <<<
== /.zshrc ==
# >>> shm >>>
# Managed by shm; changes inside this block are overwritten. Config: ~/.zsh/
[[ -r "$HOME/.zsh/init.zsh" ]] && source "$HOME/.zsh/init.zsh"
# <<< shm <<<
== /.zsh/aliases/00-base.zsh ==
# Managed by shm (profile: aliases)
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
== /.zsh/env/00-path.zsh ==
# Managed by shm (profile: path)
path=("$HOME/.local/bin" $path)
== /.zsh/env/10-mise.zsh ==
# managed by shm (tool: mise)
path=("${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}/shims" $path)
== /.zsh/env.zsh ==
# Managed by shm; changes here are overwritten by `shm update`.
# Your environment goes in ~/.zsh/env/*.zsh (loaded by every zsh, keep it quiet).
(( ${+_SHM_ENV_LOADED} )) && return
_SHM_ENV_LOADED=1
typeset -U path
for _shm_f in "$HOME"/.zsh/env/*.zsh(N); do source "$_shm_f"; done
unset _shm_f
== /.zsh/init.zsh ==
# Managed by shm; changes here are overwritten by `shm update`.
# Your config goes in ~/.zsh/{env,functions,completions,aliases,local}/
[[ -o interactive ]] || return
[[ -r "$HOME/.zsh/env.zsh" ]] && source "$HOME/.zsh/env.zsh"
fpath=("$HOME/.zsh/completions" "$HOME/.zsh/functions" $fpath)
() { (( $# )) && autoload -Uz "$@" } "$HOME"/.zsh/functions/*(N-.:t)
for _shm_f in "$HOME"/.zsh/{tools,aliases,local}/*.zsh(N); do source "$_shm_f"; done
unset _shm_f
== /.zsh/tools/10-mise.zsh ==
# managed by shm (tool: mise)
eval "$(mise activate zsh)"
== /.zsh/tools/20-core.zsh ==
# Managed by shm (profile: core)
autoload -Uz compinit && compinit

HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS
== /.zsh/tools/30-antidote.zsh ==
# managed by shm (tool: antidote)
source "$HOME/.antidote/antidote.zsh"
antidote load
== /.zsh/tools/50-starship.zsh ==
# managed by shm (tool: starship)
[[ $TERM == dumb ]] || eval "$(starship init zsh)"
== /.zsh/tools/60-fzf.zsh ==
# managed by shm (tool: fzf)
[[ -t 0 && $TERM != dumb ]] && fzf --zsh >/dev/null 2>&1 && source <(fzf --zsh)
== /.zsh/tools/60-zoxide.zsh ==
# managed by shm (tool: zoxide)
eval "$(zoxide init zsh)"
