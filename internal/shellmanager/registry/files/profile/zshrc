# Generated by shell-manager — changes here are overwritten by `shm update`.
# Personal config goes in ~/.config/zsh/{env,functions,aliases,custom}.d/*.zsh

export PATH="$HOME/.local/bin:$PATH"

_shell_manager_source_dir() {
    local f
    for f in "$1"/*.zsh(N); do source "$f"; done
}

_shell_manager_source_dir "$HOME/.config/zsh/env.d"
_shell_manager_source_dir "$HOME/.config/shell-manager/zsh.d"
_shell_manager_source_dir "$HOME/.config/zsh/functions.d"
_shell_manager_source_dir "$HOME/.config/zsh/aliases.d"
_shell_manager_source_dir "$HOME/.config/zsh/custom.d"
unfunction _shell_manager_source_dir
